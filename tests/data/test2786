<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
TFTP
TFTP WRQ
mode=
</keywords>
</info>

<client>
# line ends are not converted on Windows
<features>
!win32
</features>
<server>
tftp
</server>
<name>
TFTP send with mode=netascii keeps CR and CRLF intact
</name>
<command>
-T %LOGDIR/test%TESTNUMBER.txt "tftp://%HOSTIP:%TFTPPORT//%TESTNUMBER;mode=netascii"
</command>
<file name="%LOGDIR/test%TESTNUMBER.txt">
unix line
dos line%CR
bare%CR carriage return
nul after cr%CR%hex[%00]hex% end
</file>
</client>

<verify>
<strip>
^timeout = [5-6]$
</strip>
<upload>
unix line
dos line%CR
bare%CR carriage return
nul after cr%CR%hex[%00]hex% end
</upload>
<protocol>
opcode = 2
mode = netascii
tsize = 0
blksize = 512
filename = /%TESTNUMBER
</protocol>
</verify>
</testcase>
