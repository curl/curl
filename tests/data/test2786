<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
TFTP
TFTP WRQ
</keywords>
</info>

<client>
# line ends are not converted on Windows
<features>
!win32
</features>
<server>
tftp
</server>
<name>
TFTP send with --use-ascii, CR and CRLF across a block boundary
</name>
<command>
-T %LOGDIR/test%TESTNUMBER.txt --use-ascii tftp://%HOSTIP:%TFTPPORT//%TESTNUMBER
</command>
<file name="%LOGDIR/test%TESTNUMBER.txt">
%repeat[511 x a]%
%repeat[510 x b]%%CR
unix line
dos line%CR
bare%CR carriage return
nul after cr%CR%hex[%00]hex% end
</file>
</client>

<verify>
<strip>
^timeout = [5-6]$
</strip>
<upload>
%repeat[511 x a]%
%repeat[510 x b]%%CR
unix line
dos line%CR
bare%CR carriage return
nul after cr%CR%hex[%00]hex% end
</upload>
<protocol>
opcode = 2
mode = netascii
tsize = 0
blksize = 512
filename = /%TESTNUMBER
</protocol>
</verify>
</testcase>
