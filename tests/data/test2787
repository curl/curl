<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
TFTP
TFTP WRQ
</keywords>
</info>

<client>
<server>
tftp
</server>
<name>
TFTP send with --use-ascii, line ends across a block boundary
</name>
<command>
-T %LOGDIR/test%TESTNUMBER.txt --use-ascii tftp://%HOSTIP:%TFTPPORT//%TESTNUMBER
</command>
<file name="%LOGDIR/test%TESTNUMBER.txt">
%repeat[511 x a]%
%repeat[510 x b]%%CR
end
</file>
</client>

<verify>
<strip>
^timeout = [5-6]$
</strip>
<upload>
%repeat[511 x a]%
%repeat[510 x b]%%CR
end
</upload>
<protocol>
opcode = 2
mode = netascii
tsize = 0
blksize = 512
filename = /%TESTNUMBER
</protocol>
</verify>
</testcase>
