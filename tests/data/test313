<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTPS
HTTP GET
PEM certificate
CRL
</keywords>
</info>

<client>
<features>
SSL
local-http
!Schannel
!wolfssl
</features>
<server>
https test-localhost.pem
</server>
<name>
CRL test
</name>
<command>
-4 --cacert %CERTDIR/certs/test-ca.crt --crlfile %CERTDIR/certs/test-localhost.crl https://localhost:%HTTPSPORT/%TESTNUMBER
</command>
</client>

<verify>
<errorcode>
60
</errorcode>
</verify>
</testcase>
