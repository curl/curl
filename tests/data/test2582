<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
cookies
</keywords>
</info>

<reply>
<data crlf="headers">
HTTP/1.1 200 OK
Content-Length: 0

</data>

</reply>

# Client-side
<client>
<features>
PSL
cookies
</features>
<server>
http
</server>
<name>
Get cookies from jar using single-component domain name
</name>
<command>
--resolve my-machine:%HTTPPORT:%HOSTIP -b "%LOGDIR/dump%TESTNUMBER" http://my-machine:%HTTPPORT/%TESTNUMBER
</command>

<file name="%LOGDIR/dump%TESTNUMBER">
# Netscape HTTP Cookie File
# https://curl.se/docs/http-cookies.html
# This file was generated by libcurl! Edit at your own risk.

my-machine%TABFALSE%TAB/%TABFALSE%TAB0%TABworld%TABcrazy
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: my-machine:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*
Cookie: world=crazy

</protocol>
</verify>
</testcase>
