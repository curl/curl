<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SMTP
VRFY
IDN
</keywords>
</info>

<reply>
<servercmd>
CAPA SMTPUTF8
</servercmd>
<data crlf="yes">
252 Send some mail and I'll try my best
</data>
</reply>

<client>
<server>
smtp
</server>
<features>
IDN
!win32
codeset-utf8
</features>
<setenv>
LC_ALL=C.UTF-8
</setenv>
<name>
SMTP external VRFY with SMTPUTF8 support
</name>
<command>
smtp://%HOSTIP:%SMTPPORT/%TESTNUMBER --mail-rcpt Anv%hex[%c3%a4]hex%ndaren@%hex[%c3%a5%c3%a4%c3%b6]hex%.se
</command>
</client>

<verify>
<protocol crlf="yes">
EHLO %TESTNUMBER
VRFY Anv%hex[%c3%a4]hex%ndaren@xn--4cab6c.se SMTPUTF8
QUIT
</protocol>
</verify>
</testcase>
