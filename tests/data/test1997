<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
Alt-Svc
</keywords>
</info>

# Server-side
<reply>
<data>
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Content-Length: 6
Connection: close
Alt-Svc: h1="nowhere.foo:80"; ma=9223372036854775807

-foo-
</data>
</reply>

# Client-side
<client>
<features>
Debug
alt-svc
</features>
<server>
http
</server>
<name>
Alt-Svc with huge 'ma'
</name>
<setenv>
# Sep 1, 2014
CURL_TIME=1409522400
# make Debug-curl accept Alt-Svc over plain HTTP
CURL_ALTSVC_HTTP="yeah"
</setenv>
<command>
http://%HOSTIP:%HTTPPORT/ --alt-svc "%LOGDIR/altsvc-%TESTNUMBER"
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET / HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

</protocol>
<file name="%LOGDIR/altsvc-%TESTNUMBER" mode="text">
# Your alt-svc cache. https://curl.se/docs/alt-svc.html
# This file was generated by libcurl! Edit at your own risk.
h1 %HOSTIP %HTTPPORT h1 nowhere.foo 80 "20160830 22:00:00" 0 0
</file>
</verify>
</testcase>
