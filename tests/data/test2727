<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
WebSockets
CURLOPT_CONNECT_ONLY
</keywords>
</info>

# Server-side
<reply>
<data crlf="headers" nocheck="yes">
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 11

no upgrade
</data>
</reply>

# Client-side
<client>
# require Debug for the forced CURL_ENTROPY
<features>
Debug
ws
verbose-strings
</features>
<setenv>
CURL_ENTROPY=12345678
</setenv>
<server>
http
</server>
<tool>
lib%TESTNUMBER
</tool>
<name>
Refused WebSocket upgrade with CONNECT_ONLY=2 reuses connection
</name>
<command>
- %HOSTIP %HTTPPORT
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET /path/ws/%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Accept: */*
Upgrade: websocket
Sec-WebSocket-Version: 13
Sec-WebSocket-Key: stripped
Connection: Upgrade

GET /path/ws/%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Accept: */*
Upgrade: websocket
Sec-WebSocket-Version: 13
Sec-WebSocket-Key: stripped
Connection: Upgrade

GET /path/ws/%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Accept: */*
Upgrade: websocket
Sec-WebSocket-Version: 13
Sec-WebSocket-Key: stripped
Connection: Upgrade

</protocol>
<strip>
^Host:.*
</strip>
# Only the first Sec-WebSocket-Key is reproducible under CURL_ENTROPY, so
# the nonce is stripped and only its presence is implied by the other headers.
<strippart>
s/^Sec-WebSocket-Key: [^\r\n]*/Sec-WebSocket-Key: stripped/
</strippart>
### Requests 2 and 3 must reuse connection #0. We must not see
### "closing connection" between them.
<file name="%LOGDIR/stderr%TESTNUMBER" mode="text">
* WebSocket upgrade refused with HTTP 200
* Connection #0 to host %HOSTIP:%HTTPPORT left intact
Request 1 (WS refused) completed. CURLcode: 102 (WebSocket denied by server). HTTP Code: 200.
* Reusing existing ws: connection with host %HOSTIP
* WebSocket upgrade refused with HTTP 200
* Connection #0 to host %HOSTIP:%HTTPPORT left intact
Request 2 (WS refused) completed. CURLcode: 102 (WebSocket denied by server). HTTP Code: 200.
* Reusing existing ws: connection with host %HOSTIP
* WebSocket upgrade refused with HTTP 200
* Connection #0 to host %HOSTIP:%HTTPPORT left intact
Request 3 (WS refused) completed. CURLcode: 102 (WebSocket denied by server). HTTP Code: 200.
</file>
<stripfile>
$_ = '' if(($_ !~ /left intact/) and ($_ !~ /closing connection/) and ($_ !~ /WebSocket upgrade refused/) and ($_ !~ /Reusing existing/) and ($_ !~ /shutting down/) and ($_ !~ /^Request \d/))
</stripfile>
</verify>
</testcase>
