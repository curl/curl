<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
compressed
</keywords>
</info>
<reply>
# A zstd frame containing a raw block for "hello world", cut after "hello".
# Content-Length matches the encoded bytes so HTTP framing is complete.
<data crlf="headers" nonewline="yes" nocheck="yes">
HTTP/1.1 200 OK
Content-Encoding: zstd
Content-Length: 14

%hex[%28%b5%2f%fd%20%0b%59%00%00%68%65%6c%6c%6f]hex%
</data>
</reply>

<client>
<features>
zstd
</features>
<server>
http
</server>
<name>
HTTP GET incomplete zstd compressed content
</name>
<command option="no-include">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --compressed --remove-on-error -o %LOGDIR/decoded%TESTNUMBER
</command>
</client>

<verify>
<strippart>
s/^Accept-Encoding: [a-zA-Z, ]*/Accept-Encoding: xxx/
</strippart>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*
Accept-Encoding: xxx

</protocol>
<notexists>
%LOGDIR/decoded%TESTNUMBER
</notexists>
<errorcode>
61
</errorcode>
</verify>
</testcase>
