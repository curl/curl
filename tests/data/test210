<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FTP
</keywords>
</info>

<reply>
<data>
data blobb
</data>

# data is sent to stdout
</reply>

<client>
<server>
ftp
</server>
<name>
Get two FTP files from the same remote dir: no second CWD
</name>
<command option="no-include">
ftp://%HOSTIP:%FTPPORT/a/path/%TESTNUMBER ftp://%HOSTIP:%FTPPORT/a/path/%TESTNUMBER
</command>
<stdout>
data blobb
data blobb
</stdout>
</client>

<verify>
<protocol crlf="yes">
USER anonymous
PASS ftp@example.com
PWD
CWD a
CWD path
EPSV
TYPE I
SIZE %TESTNUMBER
RETR %TESTNUMBER
EPSV
SIZE %TESTNUMBER
RETR %TESTNUMBER
QUIT
</protocol>
</verify>
</testcase>
