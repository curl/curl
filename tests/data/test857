</data>
<datacheck crlf="yes">
From: me@somewhere
To: fake@nowhere

.body with a single dot first
..triple dots...

--
  yours sincerely
</datacheck>
</reply>

<client>
<server>
pop3
</server>
<name>
POP3 RETR message with dot-prefixed line
</name>
<command>
pop3://%HOSTIP:%POP3PORT/%TESTNUMBER -u user:secret
</command>
</client>

<verify>
<protocol crlf="yes">
CAPA
USER user
PASS secret
RETR %TESTNUMBER
QUIT
</protocol>
</verify>
