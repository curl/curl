<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
digest
</keywords>
</info>

# realm and username are UTF-8 with bytes >= 0x80
<reply>
<data crlf="headers">
HTTP/1.1 401 Authorization Required
WWW-Authenticate: Digest realm="%hex[%C3%81rea]hex%", nonce="1053604145"
Content-Length: 4

hej
</data>

<data1000 crlf="headers">
HTTP/1.1 200 OK
Content-Length: 23

This IS the real page!
</data1000>

<datacheck crlf="headers">
HTTP/1.1 401 Authorization Required
WWW-Authenticate: Digest realm="%hex[%C3%81rea]hex%", nonce="1053604145"
Content-Length: 4

HTTP/1.1 200 OK
Content-Length: 23

This IS the real page!
</datacheck>
</reply>

<client>
<server>
http
</server>
<features>
!SSPI
crypto
digest
</features>
<name>
HTTP Digest with non-ASCII username and realm
</name>
<command>
http://jos%C3%A9:secret@%HOSTIP:%HTTPPORT/%TESTNUMBER --digest
</command>
</client>

# bytes >= 0x80 are sent as-is, the response is calculated over them
<verify>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Authorization: Digest username="%hex[jos%C3%A9]hex%", realm="%hex[%C3%81rea]hex%", nonce="1053604145", uri="/%TESTNUMBER", response="8cfdd48a7ce802fa5cd5b1f3e1d2ba8a"
User-Agent: curl/%VERSION
Accept: */*

</protocol>
</verify>
</testcase>
