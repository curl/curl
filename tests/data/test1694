<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
WebSockets
RECURSIVE_API_CALL
libtest
</keywords>
</info>

# Server-side
<reply>
<data crlf="headers" nocheck="yes" nonewline="yes">
HTTP/1.1 101 Switching to WebSockets
Server: test-server/fake
Upgrade: websocket
Connection: Upgrade
Something: else
Sec-WebSocket-Accept: HkPsVga7+8LuxM4RGQ5p9tZHeYs=

%hex[%81%05hello]hex%
</data>
# allow upgrade
<servercmd>
upgrade
</servercmd>
</reply>

# Client-side
<client>
# require Debug for the forced CURL_ENTROPY
<features>
Debug
ws
verbose-strings
</features>
<setenv>
CURL_ENTROPY=12345678
</setenv>
<server>
http
</server>
<name>
verify api is protected against calls from the debug callback
</name>
<command>
ws://%HOSTIP:%HTTPPORT/%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
# 93 == CURLE_RECURSIVE_API_CALL
<stdout>
transfer: curl_easy_pause returned 93
transfer: curl_ws_recv returned 93
transfer: curl_ws_send returned 93
transfer: curl_ws_start_frame returned 93
connect-only: curl_easy_pause returned 93
connect-only: curl_ws_recv returned 93
connect-only: curl_ws_send returned 93
connect-only: curl_ws_start_frame returned 93
curl_ws_send returned 0
</stdout>
<errorcode>
0
</errorcode>
</verify>
</testcase>
