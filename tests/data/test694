<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SFTP
server key check
SHA256
connection reuse
</keywords>
</info>

<reply>
<data>
test
</data>
</reply>

<client>
<server>
sftp
</server>
<name>
SFTP no connection reuse for a transfer with a different host key
</name>
<command>
--hostpubsha256 %SSHSRVSHA256 --key %LOGDIR/server/curl_client_key --pubkey %LOGDIR/server/curl_client_key.pub -u %USER: sftp://%HOSTIP:%SSHPORT%SFTP_PWD/%LOGDIR/file%TESTNUMBER.txt --next --hostpubsha256 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= --key %LOGDIR/server/curl_client_key --pubkey %LOGDIR/server/curl_client_key.pub -u %USER: sftp://%HOSTIP:%SSHPORT%SFTP_PWD/%LOGDIR/file%TESTNUMBER.txt
</command>
<setenv>
# Needed for MSYS2 to not treat the base64 hash argument as a POSIX path list
# that has to be converted to Windows paths
MSYS2_ARG_CONV_EXCL=*
</setenv>
<file name="%LOGDIR/file%TESTNUMBER.txt">
test
</file>
</client>

<verify>
<errorcode>
60
</errorcode>
</verify>
</testcase>
