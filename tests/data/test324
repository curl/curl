# Verify data after the test has been "shot"
#
# A 307 keeps the request method, so the form is uploaded to the redirect
# target. The custom headers still become mail headers, except for the two
# that may not be sent to another host.
<verify>
<protocol crlf="yes">
POST /page/%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*
Authorization: Bearer s3cr3t
Cookie: sid=s3cr3t
Authorization : Bearer spaced
Subject: afternoon meeting
Content-Length: 156
Content-Type: multipart/form-data; boundary=----------------------------

------------------------------%CR
Content-Disposition: form-data; name="name"%CR
%CR
value%CR
--------------------------------%CR
B001 CAPABILITY
B002 APPEND %TESTNUMBER (\Seen) {294}
B003 LOGOUT
</protocol>
<strippart>
s/^--------------------------[A-Za-z0-9]*/------------------------------/
s/boundary=------------------------[A-Za-z0-9]*/boundary=----------------------------/
</strippart>
<upload>
Content-Type: multipart/mixed; boundary=----------------------------%CR
Mime-Version: 1.0%CR
Subject: afternoon meeting%CR
%CR
------------------------------%CR
Content-Disposition: attachment; name="name"%CR
%CR
value%CR
--------------------------------%CR
</upload>
</verify>
