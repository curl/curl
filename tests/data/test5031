<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
IMAP Clear Text FETCH CUSTOMREQUEST CONNECTION_REUSE
</keywords>
</info>

<reply>
<servercmd>
IMAPFETCHONEWRITE
</servercmd>
<data crlf="yes">
Subject: demo

</data>
<datacheck>
* 1 FETCH (BODY[] {17}%CR
Subject: demo%CR
%CR
</datacheck>
</reply>

<client>
<server>
imap
</server>
<name>
IMAP custom FETCH response and tagged completion sent in one write
</name>
<command>
-v 'imap://%HOSTIP:%IMAPPORT/%TESTNUMBER' -u user:secret -X 'FETCH 1 BODY[]' --next 'imap://%HOSTIP:%IMAPPORT/%TESTNUMBER' -u user:secret -X NOOP
</command>
</client>

<verify>
<protocol crlf="yes">
A001 CAPABILITY
A002 LOGIN user secret
A003 SELECT %TESTNUMBER
A004 FETCH 1 BODY[]
A005 NOOP
A006 LOGOUT
</protocol>

<stripfile>
if(/> A005 NOOP/) { s/.*> A005 NOOP.*?/NOOP-SENT/; } elsif(/^< \)/) { s/^< \).*/FETCH-CLOSE/; } elsif(/^< A004 OK FETCH completed/) { s/^< A004 OK FETCH completed.*/FETCH-DONE/; } else { $_ = ""; }
</stripfile>

<stderr mode="text">
FETCH-CLOSE
FETCH-DONE
NOOP-SENT
</stderr>

</verify>
</testcase>
