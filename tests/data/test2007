<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SFTP
--quote
</keywords>
</info>

# Server-side
<reply>
</reply>

# Client-side
<client>
<server>
sftp
</server>
<name>
SFTP quote rmdir command with trailing junk
</name>
<command>
--hostpubsha256 %SSHSRVSHA256 --key %LOGDIR/server/curl_client_key --pubkey %LOGDIR/server/curl_client_key.pub -u %USER: sftp://%HOSTIP:%SSHPORT%SFTP_PWD/%LOGDIR/file%TESTNUMBER.txt -Q "mkdir /tmp/test trailing_garbage"
</command>
<setenv>
# Needed for MSYS2 to not treat the base64 hash argument as a POSIX path list
# that has to be converted to Windows paths
MSYS2_ARG_CONV_EXCL=*
</setenv>
</client>

<verify>
<errorcode>
21
</errorcode>
</verify>
</testcase>
