<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
IMAPS
FETCH
</keywords>
</info>

<reply>
<data crlf="yes">
From: me@somewhere
To: fake@nowhere

body

--
  yours sincerely
</data>
</reply>

<client>
<server>
imaps
</server>
<name>
IMAPS FETCH with redundant explicit SSL request
</name>
<command>
--insecure --ssl-reqd -u '"user:sec"ret{' 'imaps://%HOSTIP:%IMAPSPORT/%TESTNUMBER/;MAILINDEX=1'
</command>
</client>

<verify>
<protocol crlf="yes">
A001 CAPABILITY
A002 LOGIN "\"user" "sec\"ret{"
A003 SELECT %TESTNUMBER
A004 FETCH 1 BODY[]
A005 LOGOUT
</protocol>
</verify>
</testcase>
