<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
--no-clobber
--retry
--retry-all-errors
</keywords>
</info>

<reply>
<data nocheck="yes">
HTTP/1.0 200 OK
Connection: close
Content-Type: text/plain
Content-Length: 4

foo
</data>
</reply>

<client>
<name>
Retry when --no-clobber runs out of numbered filenames
</name>
<server>
http
</server>
<features>
http
Debug
</features>
<setenv>
CURL_MAX_CLOBBER=100
</setenv>
<command option="no-output">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -o %LOGDIR/exist%TESTNUMBER --no-clobber --retry 1 --retry-all-errors -w '%{num_retries} %{filename_effective}\n'
</command>
<file name="%LOGDIR/exist%TESTNUMBER">
to stay the same
</file>
<precheck>
%PERL -e 'for my $i ((1..100)) { my $filename = "%LOGDIR/exist%TESTNUMBER.$i"; open(FH, "%GT", $filename) or die $!; print FH "to stay the same" ; close(FH) }'
</precheck>
</client>

<verify>
<errorcode>
23
</errorcode>
<stdout mode="text">
1 %LOGDIR/exist%TESTNUMBER
</stdout>
<file name="%LOGDIR/exist%TESTNUMBER">
to stay the same
</file>
<postcheck>
%PERL -e 'for my $i ((1..100)) { my $filename = "%LOGDIR/exist%TESTNUMBER.$i"; open(FH, "%LT", $filename) or die $!; (%LTFH%GT eq "to stay the same" and %LTFH%GT eq "") or die "incorrect $filename" ; close(FH) }'
</postcheck>
</verify>
</testcase>
