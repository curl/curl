<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP CONNECT
HTTP proxy
connection reuse
</keywords>
</info>

<reply>
<connect crlf="headers">
HTTP/1.1 200 Tunnel established

</connect>
<data crlf="headers" nocheck="yes">
HTTP/1.1 200 OK
Content-Length: 0

</data>
</reply>

<client>
<server>
http
http-proxy
</server>
<features>
proxy
</features>
<name>
CONNECT tunnel reuse with custom authorization and suppression
</name>
<command>
--fail-early --proxytunnel --proxy-user fixture:pass -x %HOSTIP:%PROXYPORT --proxy-header "Proxy-Authorization: Bearer test-a" http://%HOSTIP:%HTTPPORT/%TESTNUMBER
--next --proxytunnel --proxy-user fixture:pass -x %HOSTIP:%PROXYPORT --proxy-header "proxy-authorization: Bearer test-b" http://%HOSTIP:%HTTPPORT/%TESTNUMBER
--next --proxytunnel --proxy-user fixture:pass -x %HOSTIP:%PROXYPORT --proxy-header "proxy-authorization: Bearer test-b" http://%HOSTIP:%HTTPPORT/%TESTNUMBER
--next --proxytunnel --proxy-user fixture:pass -x %HOSTIP:%PROXYPORT http://%HOSTIP:%HTTPPORT/%TESTNUMBER
--next --proxytunnel --proxy-user fixture:pass -x %HOSTIP:%PROXYPORT --proxy-header "Proxy-Authorization:" http://%HOSTIP:%HTTPPORT/%TESTNUMBER
</command>
</client>

<verify>
<proxy crlf="headers">
CONNECT %HOSTIP:%HTTPPORT HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive
Proxy-Authorization: Bearer test-a

CONNECT %HOSTIP:%HTTPPORT HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive
proxy-authorization: Bearer test-b

CONNECT %HOSTIP:%HTTPPORT HTTP/1.1
Host: %HOSTIP:%HTTPPORT
Proxy-Authorization: Basic Zml4dHVyZTpwYXNz
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive

CONNECT %HOSTIP:%HTTPPORT HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive

</proxy>
</verify>
</testcase>
