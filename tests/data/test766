<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FTP
PORT
CURLOPT_SOCKOPTFUNCTION
timing-dependent
libtest
</keywords>
</info>

<reply>
<data nocheck="yes">
hello
</data>
</reply>

<client>
<server>
ftp
</server>
<name>
FTP PORT with sockopt callback refusing the accept
</name>
<command>
ftp://%HOSTIP:%FTPPORT/path/%TESTNUMBER
</command>
</client>

<verify>
# Strip off parts of the EPRT command that might differ
<strippart>
s/^EPRT \|1\|(\S*)/EPRT \|1\|/
</strippart>
# The TYPE command might get sent so we ignore that
<strip>
^TYPE
</strip>

<protocol crlf="yes">
USER anonymous
PASS ftp@example.com
PWD
CWD path
EPRT |1|
</protocol>

# 42 == CURLE_ABORTED_BY_CALLBACK
<errorcode>
42
</errorcode>

</verify>
</testcase>
