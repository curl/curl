HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 4
Set-Cookie: k=10; Partitioned; Secure; SameSite=None

boo
</data9>
<data10>
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 4

boo
</data10>
<data11>
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 4

boo
</data11>
# a cross-site navigation to localhost sets a Partitioned cookie, keyed by
# http://localhost: sent for a part of a localhost page (13) and in another
# navigation to localhost (15) but not for a part of a page of another site
# (14)
<data12>
