<testcase>
<info>
<keywords>
HTTP
cookies
SameSite
Partitioned
CURLOPT_COOKIE_SITE
CURLOPT_COOKIE_CONTEXT
libtest
</keywords>
</info>

<reply>
# cross-site request for a part of a page: Lax and Strict cookies are not
# stored, SameSite=None and Partitioned require Secure, an unknown SameSite
# value is the default (Lax)
<data1>
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 4
Set-Cookie: a=1; SameSite=Lax
Set-Cookie: b=2; SameSite=None
Set-Cookie: c=3; SameSite=None; Secure
Set-Cookie: d=4; Partitioned
Set-Cookie: e=5; Partitioned; Secure; SameSite=None
Set-Cookie: f=6; SameSite=Strict
Set-Cookie: g=7; SameSite=bogus

boo
</data1>
# cross-site navigation: cookies are stored. Partitioned cookies are keyed
# by the scheme and host navigated to, so the ones of http://other.example
# are not sent in a navigation to %HOSTIP
<data2>
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 4
Set-Cookie: h=8; SameSite=Strict
Set-Cookie: i=9

boo
</data2>
<data3>
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 4

boo
</data3>
