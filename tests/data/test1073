<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
# Redirection is used to force curl to realize that the server is
# speaking HTTP 1.0. stdin is a regular file, so curl knows the upload
# size and can send the second request without chunked encoding.
<info>
<keywords>
HTTP
HTTP PUT
HTTP/1.0
followlocation
</keywords>
</info>

<reply>
<data crlf="headers">
HTTP/1.0 301 Redirect swsclose
Server: testcurl
Content-Type: text/plain
Location: /newlocation/%TESTNUMBER0002
Content-Length: 0
Connection: close

</data>

# This is returned for the redirected request
<data2 crlf="headers">
HTTP/1.0 200 OK swsclose
Server: testcurl
Content-Type: text/plain
Content-Length: 3
Connection: close

ok
</data2>

<datacheck crlf="headers">
HTTP/1.0 301 Redirect swsclose
Server: testcurl
Content-Type: text/plain
Location: /newlocation/%TESTNUMBER0002
Content-Length: 0
Connection: close

HTTP/1.0 200 OK swsclose
Server: testcurl
Content-Type: text/plain
Content-Length: 3
Connection: close

ok
</datacheck>
</reply>

<client>
<server>
http
</server>
<name>
HTTP PUT from stdin to HTTP 1.0 server with redirect
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -T - -L
</command>
<stdin>
This is data we upload with PUT
it comes from a file on stdin
so its size is known and it
works fine with HTTP/1.0
</stdin>
</client>

<verify>
<protocol>
PUT /%TESTNUMBER HTTP/1.1%CR
Host: %HOSTIP:%HTTPPORT%CR
User-Agent: curl/%VERSION%CR
Accept: */*%CR
Content-Length: 115%CR
%CR
This is data we upload with PUT
it comes from a file on stdin
so its size is known and it
works fine with HTTP/1.0
PUT /newlocation/%TESTNUMBER0002 HTTP/1.0%CR
Host: %HOSTIP:%HTTPPORT%CR
User-Agent: curl/%VERSION%CR
Accept: */*%CR
Content-Length: 115%CR
%CR
This is data we upload with PUT
it comes from a file on stdin
so its size is known and it
works fine with HTTP/1.0
</protocol>
</verify>
</testcase>
