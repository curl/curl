<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
IMAP
SASL
SASL AUTH GSSAPI
SASL AUTH PLAIN
GSS-API
</keywords>
</info>

<reply>
<servercmd>
AUTH GSSAPI PLAIN
REPLY "AUTHENTICATE GSSAPI" A002 NO GSSAPI must not be selected
REPLY AUTHENTICATE +
REPLY %b64[%00user@curl.test%00secret]b64% A002 OK AUTHENTICATE completed
</servercmd>
<data crlf="yes">
From: me@somewhere
To: fake@nowhere

body

--
  yours sincerely
</data>
</reply>

<client>
<server>
imap
</server>
<features>
GSS-API
!SSPI
</features>
<name>
IMAP defaults to PLAIN with a domain-qualified username and password
</name>
<command>
'imap://%HOSTIP:%IMAPPORT/%TESTNUMBER/;MAILINDEX=1' -u user@curl.test:secret
</command>
</client>

<verify>
<protocol crlf="yes">
A001 CAPABILITY
A002 AUTHENTICATE PLAIN
%b64[%00user@curl.test%00secret]b64%
A003 SELECT %TESTNUMBER
A004 FETCH 1 BODY[]
A005 LOGOUT
</protocol>
</verify>
</testcase>
