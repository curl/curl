<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
compressed
</keywords>
</info>

<reply>
# A gzip stream cut off in the compressed body; Content-Length is accurate.
<data crlf="headers" nonewline="yes" nocheck="yes">
HTTP/1.1 200 OK
Content-Encoding: gzip
Content-Length: 20

%hex[%1f%8b%08%00%00%00%00%00%00%03%cb%48%cd%c9%c9%57%28%cf%2f%ca]hex%
</data>
</reply>

<client>
<features>
libz
</features>
<server>
http
</server>
<name>
Truncated gzip content preserves decoded output on error
</name>
<command option="no-output,no-include">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --compressed -o %LOGDIR/decoded-%TESTNUMBER
</command>
</client>

<verify>
<strippart>
s/^Accept-Encoding: [a-zA-Z, ]*/Accept-Encoding: xxx/
</strippart>
<protocol crlf="yes">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*
Accept-Encoding: xxx

</protocol>
<errorcode>
61
</errorcode>
<file name="%LOGDIR/decoded-%TESTNUMBER" nonewline="yes">
hello wor
</file>
</verify>
</testcase>
