<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
TELNET
UPLOAD
</keywords>
</info>

# Server-side
<reply>
<data>
</data>
</reply>

# Client-side
<client>
<server>
telnet
</server>
<features>
telnet
Debug
</features>
<setenv>
CURL_DBG_SOCK_WPARTIAL=50
</setenv>
<name>
TELNET NEW_ENVIRON reply with partial writes
</name>
<stdin>
test%TESTNUMBER
</stdin>
<command>
telnet://%HOSTIP:%TELNETPORT --upload-file - -t NEW_ENV=TERMINALTYPE,curltestterminal
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout nonewline="yes">
test%TESTNUMBER
TERMINALTYPE=curltestterminal
</stdout>
</verify>
</testcase>
