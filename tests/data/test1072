<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
# Authorization is used to force curl to realize that the server is
# speaking HTTP 1.0. stdin is a regular file, so curl knows the upload
# size and can send the second request without chunked encoding.
<info>
<keywords>
HTTP
HTTP PUT
HTTP Digest auth
--anyauth
HTTP/1.0
</keywords>
</info>

<reply>
<data crlf="headers">
HTTP/1.0 401 Authorization Required swsclose
Server: testcurl
WWW-Authenticate: Blackmagic realm="gimme all yer s3cr3ts"
WWW-Authenticate: Basic realm="gimme all yer s3cr3ts"
WWW-Authenticate: Digest realm="gimme all yer s3cr3ts", nonce="11223344"
Content-Type: text/plain
Content-Length: 0
Connection: close

</data>

# This is returned when the server gets an Authorization: Digest
# header from the client
<data1000 crlf="headers">
HTTP/1.0 200 OK swsclose
Server: testcurl
Content-Type: text/plain
Content-Length: 3
Connection: close

ok
</data1000>

<datacheck crlf="headers">
HTTP/1.0 401 Authorization Required swsclose
Server: testcurl
WWW-Authenticate: Blackmagic realm="gimme all yer s3cr3ts"
WWW-Authenticate: Basic realm="gimme all yer s3cr3ts"
WWW-Authenticate: Digest realm="gimme all yer s3cr3ts", nonce="11223344"
Content-Type: text/plain
Content-Length: 0
Connection: close

HTTP/1.0 200 OK swsclose
Server: testcurl
Content-Type: text/plain
Content-Length: 3
Connection: close

ok
</datacheck>
</reply>

<client>
<server>
http
</server>
<features>
!SSPI
crypto
digest
md5
</features>
<name>
HTTP PUT from stdin to HTTP 1.0 server with authorization
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -T - -u testuser:testpass --anyauth
</command>
<stdin>
This is data we upload with PUT
it comes from a file on stdin
so its size is known and it
works fine with HTTP/1.0
</stdin>
</client>

<verify>
<protocol>
PUT /%TESTNUMBER HTTP/1.1%CR
Host: %HOSTIP:%HTTPPORT%CR
User-Agent: curl/%VERSION%CR
Accept: */*%CR
Content-Length: 115%CR
%CR
This is data we upload with PUT
it comes from a file on stdin
so its size is known and it
works fine with HTTP/1.0
PUT /%TESTNUMBER HTTP/1.0%CR
Host: %HOSTIP:%HTTPPORT%CR
Authorization: Digest username="testuser", realm="gimme all yer s3cr3ts", nonce="11223344", uri="/%TESTNUMBER", response="5ddefbe373338abcf063488ac8433799"%CR
User-Agent: curl/%VERSION%CR
Accept: */*%CR
Content-Length: 115%CR
%CR
This is data we upload with PUT
it comes from a file on stdin
so its size is known and it
works fine with HTTP/1.0
</protocol>
</verify>
</testcase>
