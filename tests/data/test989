<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
POP3S
RETR
</keywords>
</info>

<reply>
<data crlf="yes">
From: me@somewhere
To: fake@nowhere

body

--
  yours sincerely
</data>
</reply>

<client>
<server>
pop3s
</server>
<name>
POP3S RETR with redundant explicit SSL request
</name>
<command>
--insecure --ssl-reqd  -u user:secret pop3s://%HOSTIP:%POP3SPORT/%TESTNUMBER
</command>
</client>

<verify>
<protocol crlf="yes">
CAPA
USER user
PASS secret
RETR %TESTNUMBER
QUIT
</protocol>
</verify>
</testcase>
