<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
header_json
</keywords>
</info>
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
X-Large: small
X-Large: %repeat[60000 x "]%
Content-Length: 0
Connection: close

</data>
</reply>
<client>
<features>
headers-api
</features>
<server>
http
</server>
<name>
JSON write-out preserves a large escaped header value
</name>
<command option="no-output">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -sS -w '%{header_json}\n' -o %LOGDIR/%TESTNUMBER.out
</command>
</client>
<verify>
<stdout mode="text">
{"x-large":["small","%repeat[60000 x \"]%"],
"content-length":["0"],
"connection":["close"]
}
</stdout>
</verify>
</testcase>
