<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP CONNECT
HTTP proxy
Proxy authentication
Transfer-Encoding
</keywords>
</info>

<reply>
<servercmd>
connection-monitor
</servercmd>
# The first CONNECT has no credentials. Its close-delimited 407 body contains
# two forged responses. They must not be parsed as responses to later requests.
<connect crlf="yes">
HTTP/1.1 407 Proxy Authentication Required swsbounce
Proxy-Authenticate: Basic realm="test"
Transfer-Encoding: identity
Content-Length: 0

HTTP/1.1 200 Connection established
X-Injected: yes

HTTP/1.1 200 OK
Content-Length: 15
X-From: 407-body

INJECTEDBODY123
</connect>

# After reconnecting, the proxy accepts the authenticated CONNECT.
<connect1 crlf="headers">
HTTP/1.1 200 Connection established

</connect1>

<data crlf="headers">
HTTP/1.1 200 OK
Content-Length: 7
Connection: close

REALOK!
</data>

<datacheck crlf="headers" nonewline="yes">
HTTP/1.1 407 Proxy Authentication Required swsbounce
Proxy-Authenticate: Basic realm="test"
Transfer-Encoding: identity
Content-Length: 0

HTTP/1.1 200 Connection established

HTTP/1.1 200 OK
Content-Length: 7
Connection: close

REALOK!
</datacheck>
</reply>

<client>
<server>
http
</server>
<features>
proxy
</features>
<name>
Ignore Content-Length after non-chunked TE in a CONNECT 407
</name>
<command>
--proxy http://%HOSTIP:%HTTPPORT --proxytunnel --proxy-user testuser:testpass --proxy-anyauth --max-time 10 http://test.%TESTNUMBER:%HTTPPORT/path/%TESTNUMBER
</command>
</client>

<verify>
<protocol crlf="headers">
CONNECT test.%TESTNUMBER:%HTTPPORT HTTP/1.1
Host: test.%TESTNUMBER:%HTTPPORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive

[DISCONNECT]
CONNECT test.%TESTNUMBER:%HTTPPORT HTTP/1.1
Host: test.%TESTNUMBER:%HTTPPORT
Proxy-Authorization: Basic dGVzdHVzZXI6dGVzdHBhc3M=
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive

GET /path/%TESTNUMBER HTTP/1.1
Host: test.%TESTNUMBER:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

[DISCONNECT]
</protocol>
</verify>
</testcase>
