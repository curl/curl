<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
</keywords>
</info>

<reply>
<connect>
HTTP/1.1 407 NoNoNo
Transfer-Encoding: chunked
Trailer: proxy-trailer

4
aaaa
0
