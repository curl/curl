CC ?= gcc
CFLAGS ?= -Wall -Wextra -Werror -pedantic -std=c89 -g -I../include -I../src -D_GNU_SOURCE -Werror
SSL_CFLAGS ?= $(shell pkg-config --cflags openssl 2>/dev/null)
SSL_LIBS ?= $(shell pkg-config --libs openssl 2>/dev/null || echo "-lssl -lcrypto")

LIB = ../.libs/libschannelmockup.a

TESTS = test_credentials test_sspi_handshake test_encrypt_decrypt

.PHONY: all test clean

all: $(TESTS)

test_credentials: test_credentials.o $(LIB)
	$(CC) $(CFLAGS) $^ $(SSL_LIBS) -o $@

test_sspi_handshake: test_sspi_handshake.o $(LIB)
	$(CC) $(CFLAGS) $^ $(SSL_LIBS) -o $@

test_encrypt_decrypt: test_encrypt_decrypt.o $(LIB)
	$(CC) $(CFLAGS) $^ $(SSL_LIBS) -o $@

%.o: %.c
	$(CC) $(CFLAGS) $(SSL_CFLAGS) -c $< -o $@

test: $(TESTS)
	./test_credentials
	./test_sspi_handshake
	./test_encrypt_decrypt

clean:
	rm -f $(TESTS) *.o
