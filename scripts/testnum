use strict;
use warnings;

my $num = 10; # provide (at least) this many proposals

my @all;
my $expect = 0;

open(F, "<tests/data/Makefile.am");
while(<F>) {
    if(/^TESTCASES/) {
        $expect = 1;
    }
    elsif($expect) {
        if(/^  test(\d+)/) {
            my $f = $1;
            if($f == $expect) {
                $expect = $f + 1;
            }
            else {
                if(($f - 1) != $expect) {
                    # a range
                    for my $t ($expect .. ($f - 1)) {
                        push @all, $t;
                    }
                }
                else {
                    # single value
                    push @all, $expect;
                }
            }
            $expect = $f + 1;
        }
    }
}

use List::Util qw(shuffle);

for my $t (shuffle @all) {
    print "test$t\n";
    if(!--$num) {
        last;
    }
}
