my $num = 10; # provide this many proposals

open(F, "<tests/data/Makefile.am");
while(<F>) {
    if(/^TESTCASES/) {
        $expect = 1;
    }
    elsif($expect) {
        if(/^  test(\d+)/) {
            my $f = $1;
            if($f == $expect) {
                $expect = $f + 1;
            }
            else {
                if(($f - 1) != $expect) {
                    # a range
                    printf "test$expect - ".($f -1)."\n";
                }
                else {
                    # single value
                    printf "test$expect\n";
                }
                if(!--$num) {
                    last;
                }
            }
            $expect = $f + 1;
        }
    }
}
close(F);
